          },
          "name": "InsulationMaterialsAPI",
          "stereotype": "domain /api/insulation-materials",
          "operations": [
            {
              "_type": "UMLOperation",
              "_id": "LAB4_OP_LIST",
              "_parent": {
                "$ref": "LAB4_CLASS_MATERIALS_API"
