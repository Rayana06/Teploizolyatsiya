                    "$ref": "LAB4_OP_CREATE"
                  },
                  "name": "video",
                  "type": "file"
                },
                {
                  "_type": "UMLParameter",
                  "_id": "LAB4_OP_CREATE_RETURN",
                  "_parent": {
                    "$ref": "LAB4_OP_CREATE"
                  },
                  "type": "draft",
                  "direction": "return"
                }
              ]
            },
            {
              "_type": "UMLOperation",
