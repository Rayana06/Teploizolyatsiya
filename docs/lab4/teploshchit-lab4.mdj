              "stereotype": "GET /api/insulation-materials",
              "parameters": [
                {
                  "_type": "UMLParameter",
                  "_id": "LAB4_OP_LIST_P1",
                  "_parent": {
                    "$ref": "LAB4_OP_LIST"
                  },
