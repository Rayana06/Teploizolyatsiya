                },
                {
                  "_type": "UMLParameter",
                  "_id": "LAB4_OP_LIST_P2",
                  "_parent": {
                    "$ref": "LAB4_OP_LIST"
                  },
                  "name": "insulationType?",
                  "type": "string"
                },
                {
                  "_type": "UMLParameter",
                  "_id": "LAB4_OP_LIST_P3",
                  "_parent": {
                    "$ref": "LAB4_OP_LIST"
                  },
                  "name": "search?",
                  "type": "string"
                },
                {
                  "_type": "UMLParameter",
                  "_id": "LAB4_OP_LIST_RETURN",
                  "_parent": {
                    "$ref": "LAB4_OP_LIST"
                  },
                  "type": "items + count",
                  "direction": "return"
                }
              ]
            },
            {
              "_type": "UMLOperation",
              "_id": "LAB4_OP_CREATE",
