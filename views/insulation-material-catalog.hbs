{{> insulation-head}}
<main class="insulation-viewport">
  <section class="insulation-scroll insulation-catalog" aria-label="Каталог изоляционных материалов">
    {{> insulation-brand}}
    <h1>Каталог материалов</h1>
    <form class="insulation-price-filter" action="/insulation-materials/catalog" method="get">
      <label for="insulationMaxPrice">МАКСИМАЛЬНАЯ ЦЕНА ТЕПЛОИЗОЛЯЦИОННОГО МАТЕРИАЛА ЗА 1 М²</label>
      <div class="insulation-filter-row">
        <div class="insulation-price-range">
          <input id="insulationMaxPrice" name="insulationMaxPrice" type="range" min="229.63" max="1570.15" step="0.01" value="{{insulationFilterValue}}">
          <div class="insulation-range-scale"><span>229,63 ₽/м²</span><span>1 570,15 ₽/м²</span></div>
        </div>
        <button class="insulation-action" type="submit">Подобрать</button>
      </div>
    </form>
    {{#if insulationFilterError}}<p class="insulation-filter-error" role="alert">{{insulationFilterError}}</p>{{/if}}
    <p class="insulation-count">Найдено материалов: {{insulationMaterialCount}}</p>
    <div class="insulation-grid">
      {{#each insulationMaterials}}
      <article class="insulation-card" data-insulation-id="{{insulationId}}">
        <a class="insulation-card-link" href="/insulation-materials/feed/{{insulationId}}" aria-label="{{insulationName}}, {{insulationThicknessMm}} мм, {{insulationPriceLabel}} рублей за квадратный метр"><div class="insulation-card-picture"><object class="insulation-card-image" data="{{insulationImageUrl}}" type="image/jpeg" aria-label="{{insulationName}}"><img src="{{insulationDefaultImageUrl}}" alt="{{insulationName}}" width="174" height="72"></object><span class="insulation-kind">{{insulationType}}</span></div><div class="insulation-card-copy"><p class="insulation-maker">{{insulationManufacturer}} · {{insulationSku}}</p><h2>{{insulationName}}</h2><p class="insulation-application">{{insulationApplication}}</p><p class="insulation-thickness">Толщина: {{insulationThicknessMm}} мм</p><div class="insulation-card-bottom"><strong>{{insulationPriceLabel}} ₽/м²</strong><span class="insulation-likes" aria-label="{{insulationLikeCount}} лайков">♡ {{insulationLikeCount}}</span></div></div></a>
        <form class="insulation-delete-form" action="/insulation-materials/{{insulationId}}/delete" method="post"><button type="submit" aria-label="Логически удалить {{insulationName}}">Удалить</button></form>
      </article>
      {{else}}
      <p class="insulation-empty">{{#unless insulationFilterError}}Материалов по этой цене не найдено.{{/unless}} <a href="/insulation-materials/catalog">Показать все материалы</a></p>
      {{/each}}
    </div>
  </section>
  {{> insulation-tabs}}
</main>
</body></html>
